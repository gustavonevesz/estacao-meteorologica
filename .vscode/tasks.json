{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Gravação: acompanhar inserções no SQLite",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-u", "${workspaceFolder}\\scripts\\acompanhar_banco.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true}
    },
    {
      "label": "Gravação: consultar último registro em JSON",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["${workspaceFolder}\\scripts\\acompanhar_banco.py", "--uma-vez", "--limite", "1", "--json"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true}
    }
  ]
}
